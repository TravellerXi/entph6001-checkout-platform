# Never commit real secret material. 11-secret.example.yaml carries placeholders only;
# the live Secret is created at deploy time by 20-create-secret.sh from an environment variable.
11-secret.yaml
*.env
.env
kubeconfig
*.kubeconfig

node_modules/
npm-debug.log*
.DS_Store
Thumbs.db

# Review and audit working files. These record what was wrong and how it was found, so they
# belong outside anything that gets packaged. Listed here as a backstop in case one is ever
# written into this tree by mistake.
audit-v*.md
read-v*.md
edits-v*.md
judge-v*.md
critic-v*.md
fact-check-v*.md
rubric-audit-v*.md
deadlock-*.md
draft-v*.md
